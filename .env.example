# ---- Core ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase / Postgres ----
# Postgres connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rtoshield
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Security ----
# Global pepper added to per-org salts when hashing PII.
HASH_PEPPER=change-me-long-random-string
# 32-byte key (base64) for AES-256-GCM token encryption. Generate:
#   node -e "console.log('base64:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=base64:REPLACE_WITH_32_BYTE_BASE64_KEY
# Shared secret for verifying store webhooks (HMAC).
WEBHOOK_SECRET=change-me

# ---- Queue (optional) ----
# If unset, scoring runs inline (fine for local dev). Set to enable BullMQ.
REDIS_URL=

# ---- LLM / Embeddings (OpenAI-compatible; optional, mocks used if unset) ----
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- Provider toggles (default: mock) ----
IP_INTEL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
COURIER_PROVIDER=mock
